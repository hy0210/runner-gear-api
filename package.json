{
  "name": "runner-gear-api",
  "version": "1.0.0",
  "description": "跑步裝備店電商平台 API（六角學院單人專題）",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "migration:run": "node src/scripts/migrate.js",
    "migration:revert": "node src/scripts/migrate.js revert",
    "seed:admin": "node src/scripts/seed-admin.js",
    "seed": "node src/scripts/seed.js"
  },
  "repository": {
