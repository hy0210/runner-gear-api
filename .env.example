# 只列變數名稱與說明，不放任何值。實際的值放在 .env（不進版本庫）。

# 執行環境：development / test / production
NODE_ENV=
# API 在容器（或本機）內監聽的埠
PORT=

# PostgreSQL 連線。使用 docker compose 時 DB_HOST、DB_PORT 由 docker-compose.yml 指定，不必填
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# （選填）docker compose 對應到主機的埠，預設 80
API_HOST_PORT=

# 允許跨來源請求的前端網址，以逗號分隔（例：https://example.com,http://localhost:5173）。正式環境必填
CORS_ORIGINS=

# JWT 簽章密鑰：至少 32 個字元的隨機字串，可用 `openssl rand -hex 32` 產生
JWT_SECRET=
# （選填）JWT 有效期限，例：12h、7d。預設 7d
JWT_EXPIRES_IN=

# （選填）前方反向代理的層數。正式環境預設 1（CloudFront），其餘預設 0
TRUST_PROXY=

# 管理員帳號（只給 `npm run seed:admin` 使用；ADMIN_EMAIL 請對應 email 欄位，密碼至少 8 個字元）
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
